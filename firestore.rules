// Firestore security rules for the shared high score boards.
// Firebase console → Firestore Database → Rules → paste → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coin run: coins collected in 90 seconds
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'wind', 'shifts', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 ]{3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 500
        && request.resource.data.wind is int
        && request.resource.data.shifts is string && request.resource.data.shifts.size() <= 20
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    // Gunk swarm: highest level reached, and seconds afloat to break ties
    match /survScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'level', 't', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 ]{3}$')
        && request.resource.data.level is int
        && request.resource.data.level >= 2 && request.resource.data.level <= 200
        && request.resource.data.t is int
        && request.resource.data.t >= 0 && request.resource.data.t <= 36000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
