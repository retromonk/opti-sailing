// Firestore security rules for the shared high score boards.
// Firebase console → Firestore Database → Rules → paste → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initials that spell something rude (C/K/Q spellings included).
    // The game also sees through digits and spaces; this is the backstop.
    function cleanName(n) {
      return !(n in ['ANL', 'ARS', 'ASS', 'AZZ', 'BCH', 'BJB', 'BJS', 'BTH', 'CNT', 'COC', 'COK', 'COQ', 'COX', 'CRP', 'CUC', 'CUK', 'CUM', 'CUQ', 'CUX', 'CYS', 'DCC', 'DCK', 'DCQ', 'DCS', 'DIC', 'DIK', 'DIQ', 'DIX', 'DKC', 'DKK', 'DKQ', 'DKS', 'DQC', 'DQK', 'DQQ', 'DQS', 'FAC', 'FAG', 'FAK', 'FAQ', 'FCC', 'FCK', 'FCN', 'FCQ', 'FCR', 'FCU', 'FGT', 'FKC', 'FKK', 'FKN', 'FKQ', 'FKR', 'FKU', 'FQC', 'FQK', 'FQN', 'FQQ', 'FQR', 'FQU', 'FUC', 'FUK', 'FUQ', 'FUX', 'GAY', 'HOE', 'HRE', 'JEW', 'JIZ', 'JZZ', 'KKK', 'KMS', 'KNT', 'KOC', 'KOK', 'KOQ', 'KOX', 'KRP', 'KUC', 'KUK', 'KUM', 'KUQ', 'KUX', 'KYS', 'NGA', 'NGG', 'NGR', 'NIG', 'NOB', 'PIS', 'PNS', 'PSS', 'PSY', 'QNT', 'QOC', 'QOK', 'QOQ', 'QOX', 'QRP', 'QUC', 'QUK', 'QUM', 'QUQ', 'QUX', 'QYS', 'SEX', 'SHT', 'SLT', 'SLU', 'STF', 'SUC', 'SUK', 'SUQ', 'SUX', 'SXX', 'SXY', 'TIT', 'TTS', 'TWT', 'VAG', 'WHR', 'WTF', 'XXX']);
    }
    // Coin run: coins collected in 90 seconds
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'wind', 'shifts', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 ]{3}$')
        && cleanName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 500
        && request.resource.data.wind is int
        && request.resource.data.shifts is string && request.resource.data.shifts.size() <= 20
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    // Gunk swarm: highest level reached, and seconds afloat to break ties
    match /survScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'level', 't', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 ]{3}$')
        && cleanName(request.resource.data.name)
        && request.resource.data.level is int
        && request.resource.data.level >= 2 && request.resource.data.level <= 200
        && request.resource.data.t is int
        && request.resource.data.t >= 0 && request.resource.data.t <= 36000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    // Player counts, anonymous: one doc per device (a random id the game makes
    // up and keeps on that device), and one doc per game started.
    match /players/{id} {
      allow read: if true;
      allow create: if id.matches('^[a-z0-9]{12,32}$')
        && request.resource.data.keys().hasOnly(['first', 'last', 'kind'])
        && request.resource.data.first == request.time
        && request.resource.data.last == request.time
        && request.resource.data.kind in ['phone', 'tablet', 'desktop', 'xbox'];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
        && request.resource.data.last == request.time;
      allow delete: if false;
    }
    match /plays/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pid', 'mode', 'ts'])
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 32
        && request.resource.data.mode in ['coins', 'surv', 'race', 'practice']
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
